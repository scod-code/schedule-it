# ──────────────────────────────────────────────────────────────────────────────
# Schedule-it — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Stripe keys (get from https://dashboard.stripe.com/apikeys)
# Use sk_test_... / pk_test_... during development
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Price ID for the "Full fixture schedule" product (create in Stripe dashboard)
STRIPE_PRICE_ID=price_REPLACE_ME

# Public-facing base URL of the site (no trailing slash)
# Used for Stripe success/cancel redirect URLs
APP_BASE_URL=http://localhost:8000

# Secret key for signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_ME_WITH_RANDOM_HEX

# Solver settings
SOLVER_TIME_LIMIT_SECONDS=10

# Directory where job JSON files are stored
# In Docker, this should be a mounted volume path
JOBS_DIR=./jobs

# Data retention in days (jobs older than this are deleted on startup)
DATA_RETENTION_DAYS=30

# Set to true for verbose FastAPI/Uvicorn output during development
DEBUG=false
